# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# ---------------------------------------------------------------- domain
# Domain pointed (A/AAAA record) at this host. Caddy uses it to obtain a
# Let's Encrypt certificate automatically, and serves both the account portal
# (/) and the MCP endpoint (/mcp) from it. Only needed for the production
# compose file - docker-compose.dev.yml publishes ports directly instead.
APP_DOMAIN=mcp.example.com

# Public origin the portal puts in confirmation email links. In production
# this is https://$APP_DOMAIN; locally leave it as the dev URL.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- database
POSTGRES_USER=governed
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=governed

# Used by both the portal and mcp-server. Must match the three values above.
# The host is the compose service name, not localhost.
DATABASE_URL=postgresql://governed:CHANGE_ME@db:5432/governed

# ---------------------------------------------------------------- email
# No dev mail sink is bundled - point these at a real SMTP provider even for
# local testing, or the signup -> confirm loop can't deliver its email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Governed-Superpowers <no-reply@example.com>

# ---------------------------------------------------------------- notes
# There is no MCP_SERVER_TOKEN any more. MCP tokens are per-user: sign up in
# the portal, confirm your address, then mint one on the Tokens page.
