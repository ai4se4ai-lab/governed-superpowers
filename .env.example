# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# Bearer token every /mcp request must present as `Authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
MCP_SERVER_TOKEN=

# Domain pointed (A/AAAA record) at this host, used by Caddy to obtain a
# Let's Encrypt certificate automatically. Only required for the production
# docker-compose.yml (with the caddy service) - not needed for
# docker-compose.dev.yml local testing.
MCP_DOMAIN=
